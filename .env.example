POSTGRES_SERVER_IP=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_GAME_ENGINE_DB=game_engine
PORT=3000
ADMIN_API_KEY=change_me_admin_secret_key

# Admin Login Rate Limiting (Block IP if > 3 wrong passwords in 300s / 5m)
ADMIN_AUTH_MAX_FAILURES=3
ADMIN_AUTH_WINDOW_SECONDS=300
ADMIN_AUTH_BLOCK_SECONDS=900

# Level Submission Rate Limiting (Set to 300s for 1 submission per 5m in production)
# Strategy options: IP | IP_AND_CLIENT_TOKEN (recommended behind shared corporate NATs)
LEVEL_SUBMIT_MAX_REQUESTS=1
LEVEL_SUBMIT_WINDOW_SECONDS=5
LEVEL_SUBMIT_RATE_STRATEGY=IP_AND_CLIENT_TOKEN

# Cloudflare Turnstile (Optional — leave blank if self-hosting without Cloudflare)
# TURNSTILE_MODE=AUTO activates Turnstile only when the request hostname matches TURNSTILE_DOMAIN
SITE_KEY=
SECRET_KEY=
TURNSTILE_DOMAIN=buildandplay.leighonline.net
TURNSTILE_MODE=AUTO

# Client-Side Proof-of-Work (SHA-256 Hashcash puzzle on submission)
POW_ENABLED=true
POW_DIFFICULTY=3
POW_TTL_SECONDS=300
